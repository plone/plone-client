# Connection settings read by PloneClient.from_env() and by the command line
# when no profile is selected. Profiles (plone-client profile add) are the
# better choice on a workstation: their secrets live in the system keyring.

PLONE_CLIENT_URL=http://localhost:8080/Plone
PLONE_CLIENT_USERNAME=admin
PLONE_CLIENT_PASSWORD=admin

# basic (default) or jwt
# PLONE_CLIENT_AUTH_METHOD=basic

# A JWT issued beforehand, instead of the username and password
# PLONE_CLIENT_TOKEN=

# Seconds to wait for the site (default: 30)
# PLONE_CLIENT_TIMEOUT=30

# Set to false to skip TLS verification (local development only)
# PLONE_CLIENT_VERIFY=true

# Refuse any request that could change the site
# PLONE_CLIENT_READ_ONLY=false

# Use a profile instead of the variables above
# PLONE_CLIENT_PROFILE=local
