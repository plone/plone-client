# Copy to .env and fill in your values.
# These are read automatically by PloneClientConfig.

PLONE_CLIENT_BASE_URL=http://localhost:8080/Plone
PLONE_CLIENT_USERNAME=admin
PLONE_CLIENT_PASSWORD=admin

# Optional — use a pre-issued JWT token instead of username/password
# PLONE_CLIENT_TOKEN=

# Request timeout in seconds (default: 30)
# PLONE_CLIENT_TIMEOUT=30

# Set to false/0/no to disable SSL verification (dev only!)
# PLONE_CLIENT_VERIFY_SSL=true

# Retry settings
# PLONE_CLIENT_MAX_RETRIES=3
# PLONE_CLIENT_RETRY_BACKOFF=0.5

# Logging level: DEBUG, INFO, WARNING, ERROR
# PLONE_CLIENT_LOG_LEVEL=WARNING
